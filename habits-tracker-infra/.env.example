# Copia este archivo como .env:   Copy-Item .env.example .env
# El .env nunca se sube al repositorio. Los valores de abajo sirven para probar en local;
# en cualquier otro entorno cambia POSTGRES_PASSWORD y JWT_SECRET.

# --- PostgreSQL ---
POSTGRES_DB=habitos_saludables_db
POSTGRES_USER=habitos_user
POSTGRES_PASSWORD=cambia-esta-contrasena

# --- API ---
# Secreto para firmar los tokens: mínimo 32 caracteres. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=24h
# Zona horaria que define "hoy" (rachas y fechas futuras)
ZONA_HORARIA=America/Bogota

# --- Puertos publicados en tu PC ---
API_PORT=3000
DB_PORT=5432

# --- Ruta de la API (opcional) ---
# Por omisión se construye desde ../habits-tracker-api. Cámbiala solo si clonaste en otra carpeta.
# API_PATH=../habits-tracker-api
