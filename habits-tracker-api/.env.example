# Copia este archivo como .env y cambia los valores. El .env nunca se sube al repositorio.

# PostgreSQL (los usa docker-compose.yml)
POSTGRES_DB=habitos_saludables_db
POSTGRES_USER=habitos
POSTGRES_PASSWORD=cambia-esta-contrasena

# Conexion de Prisma desde tu PC (para migrar y para `npm run start:dev`)
DATABASE_URL=postgresql://habitos:cambia-esta-contrasena@localhost:5432/habitos_saludables_db

# JWT: secreto largo y aleatorio (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=reemplaza-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=24h

PORT=3000

# Zona horaria que define "hoy" (rachas y fechas futuras)
ZONA_HORARIA=America/Bogota
