# Copia este archivo como .env (no se sube al repositorio) y ajusta la URL del API.
# EXPO_PUBLIC_ viaja dentro del bundle: aquí nunca va un secreto (security-rules.md).
#
#   Navegador o simulador de iOS en el PC:   http://localhost:3000/api/v1
#   Emulador de Android Studio:              http://10.0.2.2:3000/api/v1
#   Teléfono físico con Expo Go:             http://<IP-de-tu-PC>:3000/api/v1  (misma red Wi-Fi)
#
# Si no se define, la app usa http://localhost:3000/api/v1.
# Reemplaza IP-DE-TU-PC (en Windows la ves con: ipconfig, "Dirección IPv4" de tu Wi-Fi).
EXPO_PUBLIC_API_URL=http://IP-DE-TU-PC:3000/api/v1
