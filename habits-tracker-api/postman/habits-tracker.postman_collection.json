{
  "info": {
    "name": "Healthy Habits Tracker — API",
    "description": "Pruebas de habits-tracker-api (guía del proyecto de aula §6): login de los dos roles, 401 sin token, 403 con el rol equivocado, CRUD completo de un hábito, la regla de negocio (un registro por hábito y día) y el reporte del profesional. Usa los usuarios semilla de la migración 20261029050000_datos_semilla_por_rol. Se puede ejecutar varias veces seguidas: cada corrida crea su propio hábito y lo elimina al final.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "correoPaciente",
      "value": "paciente@habitos.test"
    },
    {
      "key": "contrasenaPaciente",
      "value": "Paciente123"
    },
    {
      "key": "correoProfesional",
      "value": "profesional@habitos.test"
    },
    {
      "key": "contrasenaProfesional",
      "value": "Profesional123"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login del paciente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoPaciente}}\",\n  \"contrasena\": \"{{contrasenaPaciente}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Devuelve un token, el rol paciente y ninguna contraseña', () => {",
                  "  pm.expect(b.token).to.be.a('string');",
                  "  pm.expect(b.usuario.rol).to.eql('paciente');",
                  "  pm.expect(b.usuario).to.not.have.property('contrasena');",
                  "});",
                  "pm.collectionVariables.set('tokenPaciente', b.token);",
                  "pm.collectionVariables.set('idPaciente', b.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoPaciente}}\",\n  \"contrasena\": \"Incorrecta9\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401 INVALID_CREDENTIALS', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS');",
                  "});",
                  "pm.test('El error tiene forma RFC 7807', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.include.keys('title', 'status', 'detail', 'code');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login del profesional",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoProfesional}}\",\n  \"contrasena\": \"{{contrasenaProfesional}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 con el rol profesional', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().usuario.rol).to.eql('profesional');",
                  "});",
                  "pm.collectionVariables.set('tokenProfesional', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
